                    IDC_STATIC,78,7,98,17
    LTEXT           "Disch\n\nFFBytes by Y Dienyddiwr Da\nhttp://bytes.jandar.net\n\nGoongyae, Grond, Zero Soul, Paulygon, The Wanderer, Decimal, and a million other people.",
                    IDC_STATIC,120,31,148,57
    LTEXT           "Tzar, Rubicant, zero soul, Riegs, Y Dienyddiwr Da, Kabucho\n\nTzar of Omniplay Gaming\nhttp://www.opgaming.com\nfor the webpage, much moral support, and just being one slick mofo",
                    IDC_STATIC,120,96,148,57
END

